# escape=`
# Windows HostProcess container image for Spegel. The base image is a
# HostProcess-only base (no full Windows userspace). ARG directives AFTER
# FROM force a layer creation that fails on this base (hcsshim cannot
# instantiate a layer for a shell-less image), so we hardcode amd64 —
# Windows HostProcess containers are amd64-only in practice.
FROM mcr.microsoft.com/oss/kubernetes/windows-host-process-containers-base-image:v1.0.0
COPY ./dist/spegel_windows_amd64/spegel.exe C:\spegel\spegel.exe
ENTRYPOINT ["C:\\spegel\\spegel.exe"]
